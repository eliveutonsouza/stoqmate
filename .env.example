# Variáveis do app Next.js — estas, e só estas, vão pro .env.local e pra Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
# Avisos por email (Resend) — src/lib/email.ts. Sem RESEND_API_KEY o app
# segue funcionando e só registra o aviso como não enviado.
RESEND_API_KEY=
EMAIL_FROM="Stoqmate <no-reply@seu-dominio-verificado>"
# Trava de teste: só envia pra estes destinatários ("@dominio" libera o
# domínio). Vazio bloqueia tudo; sem a variável = sem trava (produção).
EMAIL_TEST_ALLOWLIST=

# A origem do site NÃO é env var: `src/lib/site-origin.ts` deriva do header
# `host` da requisição, então dev, preview e produção funcionam sem config.

# --- O que NÃO é env var do app, apesar de parecer ---
#
# STRIPE_WEBHOOK_SECRET e STRIPE_SECRET_KEY são lidos via `Deno.env` dentro da
# Edge Function `supabase/functions/stripe-webhook`. Moram nos secrets do
# Supabase (`supabase secrets set ...`), não na Vercel. Pôr na Vercel não
# quebra nada, mas também não tem efeito nenhum.
#
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET não são lidos por
# nenhum código: o login com Google é intermediado pelo Supabase Auth, que
# guarda essas credenciais no próprio painel (Authentication → Sign In /
# Providers → Google). Env var com esse nome é ruído.
#
# SUPABASE_ACCESS_TOKEN (Personal Access Token) não é do app: só serve pra
# configurar o SMTP do Supabase Auth (Resend) pela Management API.

# Playwright (e2e/): conta de staff da plataforma usada nos testes do
# console admin. Só no .env.local da máquina de teste — nunca na Vercel.
# O segredo TOTP é o do 2FA dessa conta (base32).
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_STAFF_TOTP_SECRET=
